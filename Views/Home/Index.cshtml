@{
    ViewData["Title"] = "Home";
}

<h1>Library Management System</h1>
<p>Manage books, students and borrowing records.</p>

<div class="row">
    <div class="col-md-4 mb-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Books</h5>
                <p class="card-text">View, add, edit and delete books.</p>
                <a asp-controller="Book" asp-action="Index" class="btn btn-primary">Go to Books</a>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Students</h5>
                <p class="card-text">View, add and edit students.</p>
                <a asp-controller="Student" asp-action="Index" class="btn btn-primary">Go to Students</a>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Borrowing</h5>
                <p class="card-text">Record borrowed and returned books.</p>
                <a asp-controller="Borrow" asp-action="Index" class="btn btn-primary">Go to Borrowing</a>
            </div>
        </div>
    </div>
</div>