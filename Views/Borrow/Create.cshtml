@model librarymanagementapp.Models.BorrowModel

<h2>Record Borrow</h2>

<form asp-action="Create" method="post">
    <div>
        <label asp-for="StudentId"></label>
        <select asp-for="StudentId">
            <option value="0">-- Select a student --</option>
            @foreach (var student in ViewBag.Students)
            {
                <option value="@student.Id">@student.Name</option>
            }
        </select>
        <span asp-validation-for="StudentId"></span>
    </div>

    <div>
        <label asp-for="BookId"></label>
        <select asp-for="BookId">
            <option value="0">-- Select a book --</option>
            @foreach (var book in ViewBag.Books)
            {
                <option value="@book.Id">@book.Title</option>
            }
        </select>
        <span asp-validation-for="BookId"></span>
    </div>

    <div>
        <label asp-for="BorrowDate"></label>
        <input asp-for="BorrowDate" />
        <span asp-validation-for="BorrowDate"></span>
    </div>

    <button type="submit">Save</button>
    <a asp-action="Index">Cancel</a>
</form>