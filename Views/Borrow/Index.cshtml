@model List<librarymanagementapp.Models.BorrowModel>

<h2>Borrowing List</h2>

<a asp-action="Create" class="btn btn-primary mb-3">Record Borrow</a>

<table class="table">
    <thead>
        <tr>
            <th>Student</th>
            <th>Book</th>
            <th>Borrow Date</th>
            <th>Return Date</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var borrow in Model)
        {
            <tr>
                <td>@borrow.Student?.Name</td>
                <td>@borrow.Book?.Title</td>
                <td>@borrow.BorrowDate.ToShortDateString()</td>
                <td>
                    @if (borrow.ReturnDate == null)
                    {
                        <span class="text-danger">Not returned</span>
                    }
                    else
                    {
                        @borrow.ReturnDate.Value.ToShortDateString()
                    }
                </td>
                <td>
                    @if (borrow.ReturnDate == null)
                    {
                        <form asp-action="Return" method="post">
                            <input type="hidden" name="id" value="@borrow.Id" />
                            <button type="submit" class="btn btn-success btn-sm">Return</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>