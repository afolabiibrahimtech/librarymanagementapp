@model List<librarymanagementapp.Models.StudentModel>

<h2>Student List</h2>

<a asp-action="Create">Add New Student</a>

<table>
    <tr>
        <th>Name</th>
        <th>Email</th>
        <th>Phone</th>
        <th></th>
    </tr>
    @foreach (var student in Model)
    {
        <tr>
            <td>@student.Name</td>
            <td>@student.Email</td>
            <td>@student.Phone</td>
            <td>
                <a asp-action="Edit" asp-route-id="@student.Id">Edit</a>
            </td>
        </tr>
    }
</table>